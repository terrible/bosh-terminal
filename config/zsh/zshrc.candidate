
# ==========================================
# Bosh Terminal - Zsh
# ==========================================

# Rutas XDG
BOSH_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bosh-terminal"
BOSH_ANIME_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fastfetch/anime"

# Historial
HISTFILE="$HOME/.histfile"
HISTSIZE=1000
SAVEHIST=1000

# Edición y autocompletado
bindkey -e

if [[ -d /usr/share/zsh/site-functions ]]; then
    fpath=(/usr/share/zsh/site-functions $fpath)
fi

autoload -Uz compinit
compinit

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"

plugins=(
    git
    sudo
    archlinux
    colored-man-pages
)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# Autosuggestions
if [[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# Espacio entre comandos
bosh_add_newline() {
    print -P ""
}
precmd_functions+=(bosh_add_newline)

# Starship: configuración independiente
if command -v starship >/dev/null 2>&1; then
    export STARSHIP_CONFIG="$BOSH_CONFIG_DIR/starship.toml"
    eval "$(starship init zsh)"
fi

# Fastfetch con imagen anime aleatoria
if command -v fastfetch >/dev/null 2>&1; then
    bosh_fastfetch_config="$BOSH_CONFIG_DIR/fastfetch.jsonc"

    bosh_anime_images=("$BOSH_ANIME_DIR"/*.png(N))

    if (( ${#bosh_anime_images[@]} )); then
        bosh_anime_index=$(( RANDOM % ${#bosh_anime_images[@]} + 1 ))
        bosh_anime_image="${bosh_anime_images[$bosh_anime_index]}"

        if command -v chafa >/dev/null 2>&1; then
            fastfetch --config "$bosh_fastfetch_config" \
                --chafa auto \
                --logo "$bosh_anime_image" \
                --logo-width 40 \
                --logo-height 25
        else
            fastfetch --config "$bosh_fastfetch_config"
        fi
    else
        fastfetch --config "$bosh_fastfetch_config"
    fi
fi

# Syntax highlighting: siempre al final
if [[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
